---
// Amazon 板块：热销商品/优惠列表（导航栏第二个板块，带侧栏）
import Base from '../layouts/Base.astro';
import DealCard from '../components/DealCard.astro';
import dealsData from '../data/deals.json';
import reviewsData from '../data/reviews.json';

const deals = dealsData.deals;
const reviews = reviewsData.reviews;

// 侧栏排行榜：按评论数降序取前 6（自动跟着 deals.json 变）
const topReviewed = [...deals]
  .filter((d) => typeof d.reviews === 'number')
  .sort((a, b) => b.reviews - a.reviews)
  .slice(0, 6);

// 评论数格式化：4600 → 4.6k
function fmtReviews(n) {
  if (n >= 1000) {
    const v = (n / 1000).toFixed(n >= 10000 ? 0 : 1).replace(/\.0$/, '');
    return v + 'k';
  }
  return String(n);
}

// 分类入口：和测评板块保持同一套 slug
const categories = [
  { slug: 'all', label: 'All' },
  { slug: 'phones', label: 'Phones' },
  { slug: 'tablets', label: 'Tablets' },
  { slug: 'tvs', label: 'TVs' },
  { slug: 'laundry', label: 'Laundry' },
  { slug: 'cameras', label: 'Cameras' },
  { slug: 'smart-home', label: 'Smart Home' },
  { slug: 'accessories', label: 'Accessories' },
];
---
<Base
  title="Amazon Deals We're Tracking — DealWillow"
  description="Current Amazon deals and bestsellers we're tracking: prices checked when listed, buttons go straight to Amazon with our affiliate tag."
>
  <main>
    <!-- 板块横幅 -->
    <section class="hero">
      <div class="wrap hero-in">
        <h1>Amazon deals we're <span class="hl">tracking</span></h1>
        <p class="sub">Prices checked when listed, ratings pulled from Amazon. Every button opens the exact product page in a new tab.</p>
        <div class="search-box">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input id="search" type="search" placeholder="Search deals — try “camera”, “Anker”, “light”…" autocomplete="off" />
        </div>

        <!-- 板块导航：两个大按钮（当前板块实底高亮） -->
        <div class="section-nav">
          <a class="section-btn" href="/">Reviews</a>
          <a class="section-btn active" href="/amazon/">Amazon</a>
        </div>
      </div>
    </section>

    <div class="wrap home-cols">
      <div class="home-main">
        <section class="section" id="section-deals">
          <div class="section-head">
            <h2>🔥 {deals.length} items we're watching</h2>
            <span class="section-note">Sorted as listed — newest finds first</span>
          </div>
          <div class="grid">
            {deals.map((deal) => <DealCard deal={deal} />)}
          </div>
          <p class="empty" id="empty" hidden>No matches — try another word or category.</p>
        </section>
      </div>

      <!-- 侧栏：商品排行榜 + 测评文章入口 -->
      <aside class="side">
        {topReviewed.length > 0 && (
        <div class="side-box">
          <h3 class="side-title">Most-loved on Amazon</h3>
          <ol class="rank">
            {topReviewed.map((d, i) => (
              <li>
                <a class="rank-item" href={`/go/${d.id}`} target="_blank" rel="noopener sponsored">
                  <span class="rank-num">{i + 1}</span>
                  <span class="rank-name">{d.title}</span>
                  <span class="rank-meta">${d.price?.toFixed(2)} · {d.rating} ({fmtReviews(d.reviews)})</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
        )}

        {reviews.length > 0 && (
        <div class="side-box">
          <h3 class="side-title">Worth a read</h3>
          {reviews.slice(0, 4).map((r) => (
            <a class="side-review" href={`/review/${r.id}/`}>
              <span class="side-review-title">{r.title}</span>
              <span class="side-review-meta">Updated {r.updated}</span>
            </a>
          ))}
        </div>
        )}
      </aside>
    </div>
  </main>
</Base>

<script>
  // ===== 搜索 + 分类过滤 =====
  const input = document.getElementById('search');
  const emptyEl = document.getElementById('empty');

  function applyFilter() {
    const q = input.value.trim().toLowerCase();
    let visible = 0;
    document.querySelectorAll('[data-deal-card]').forEach((card) => {
      const hay = card.dataset.search || '';
      const show = !q || hay.includes(q);
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    emptyEl.hidden = visible > 0;
  }

  input?.addEventListener('input', applyFilter);
</script>

<style>
  /* 板块横幅（比首页矮一些） */
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #0d2f6e 0%, #1e66f5 100%);
    padding: 44px 0 48px;
    border-radius: 0 0 26px 26px;
    box-shadow: 0 12px 40px rgba(13, 47, 110, 0.25);
    text-align: center;
  }
  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .hero::before {
    width: 380px; height: 380px;
    background: rgba(255, 255, 255, 0.06);
    top: -170px; right: -100px;
  }
  .hero::after {
    width: 240px; height: 240px;
    background: rgba(255, 255, 255, 0.05);
    bottom: -110px; left: -70px;
  }
  .hero-in { position: relative; z-index: 1; }

  .hero h1 {
    margin: 0 0 10px;
    font-size: 34px;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: #fff;
  }
  .hl {
    background: linear-gradient(180deg, transparent 60%, #fde047 60%);
    padding: 0 3px;
  }
  .sub { margin: 0 auto 22px; color: rgba(255, 255, 255, 0.85); font-size: 15.5px; max-width: 540px; line-height: 1.6; }

  .search-box {
    display: flex; align-items: center; gap: 10px;
    max-width: 480px; margin: 0 auto;
    background: #fff;
    border-radius: 999px;
    padding: 13px 20px;
    box-shadow: 0 10px 30px rgba(4, 20, 54, 0.35);
    color: var(--muted);
    transition: box-shadow 0.15s ease;
  }
  .search-box:focus-within { box-shadow: 0 0 0 4px rgba(253, 224, 71, 0.55), 0 10px 30px rgba(4, 20, 54, 0.35); }
  .search-box input {
    border: none; outline: none; flex: 1;
    font-size: 15px; font-family: inherit; color: var(--ink);
    background: transparent;
  }
  .search-box input::placeholder { color: #9ca3af; }

  /* ===== 板块导航：两个大按钮 ===== */
  .section-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 22px; }
  .section-btn {
    display: inline-block;
    border: 2px solid rgba(255, 255, 255, 0.55);
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border-radius: 999px;
    padding: 13px 42px;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: 0.01em;
    text-decoration: none;
    backdrop-filter: blur(4px);
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .section-btn:hover { background: rgba(255, 255, 255, 0.22); transform: translateY(-1px); }
  .section-btn.active {
    background: #fff;
    border-color: #fff;
    color: #1e66f5;
    box-shadow: 0 8px 22px rgba(4, 20, 54, 0.35);
  }

  /* ===== 主体双列：左商品 + 右侧栏 ===== */
  .home-cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 36px;
    align-items: start;
    padding-top: 32px;
  }
  .side { position: sticky; top: 84px; }
  .side-box {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 18px;
    margin-bottom: 18px;
  }
  .side-title { margin: 0 0 12px; font-size: 15px; font-weight: 800; letter-spacing: -0.2px; }

  /* 排行榜 */
  .rank { margin: 0; padding: 0; list-style: none; }
  .rank li + li { border-top: 1px solid var(--border); }
  .rank-item {
    display: grid;
    grid-template-columns: 22px 1fr;
    grid-template-rows: auto auto;
    gap: 1px 8px;
    padding: 10px 4px;
    text-decoration: none;
  }
  .rank-num {
    grid-row: 1 / 3;
    width: 22px; height: 22px;
    display: flex; align-items: center; justify-content: center;
    background: var(--yellow-bg); color: var(--yellow-ink);
    border-radius: 6px;
    font-size: 12px; font-weight: 800;
  }
  .rank-name {
    font-size: 13px; font-weight: 700; color: var(--ink); line-height: 1.3;
    display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
  }
  .rank-meta { font-size: 12px; color: var(--muted); }

  /* 侧栏文章入口 */
  .side-review { display: flex; flex-direction: column; gap: 3px; text-decoration: none; padding: 9px 4px; }
  .side-review + .side-review { border-top: 1px solid var(--border); }
  .side-review-title { font-size: 13.5px; font-weight: 700; color: var(--ink); line-height: 1.35; }
  .side-review:hover .side-review-title { color: var(--blue); }
  .side-review-meta { font-size: 12px; color: var(--muted); }

  .section { margin-top: 32px; }
  .section-head { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
  .section-head h2 { margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -0.3px; }
  .section-note { font-size: 13px; color: var(--muted); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 18px;
  }

  .empty { text-align: center; color: var(--muted); padding: 48px 0; font-size: 15px; }

  @media (max-width: 1020px) {
    .home-cols { grid-template-columns: 1fr; }
    .side { position: static; display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .side-box { margin-bottom: 0; }
  }
  @media (max-width: 640px) {
    .hero { padding: 32px 0 38px; border-radius: 0 0 18px 18px; }
    .hero h1 { font-size: 26px; }
    .search-box { max-width: 100%; }
    .grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .side { grid-template-columns: 1fr; }
  }
</style>
