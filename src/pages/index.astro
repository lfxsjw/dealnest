---
// 首页（测评站版）：口号 + 搜索 + 分类 + 测评文章列表 + 追踪中的优惠 + 侧栏
import Base from '../layouts/Base.astro';
import reviewsData from '../data/reviews.json';

const reviews = reviewsData.reviews;



// 分类体系（测评站）：chips 想加品类在这里加一项，deals.json / reviews.json 的 category 用同名 slug
const categories = [
  { slug: 'all', label: 'All' },
  { slug: 'phones', label: 'Phones' },
  { slug: 'tablets', label: 'Tablets' },
  { slug: 'tvs', label: 'TVs' },
  { slug: 'laundry', label: 'Laundry' },
  { slug: 'cameras', label: 'Cameras' },
  { slug: 'smart-home', label: 'Smart Home' },
  { slug: 'accessories', label: 'Accessories' },
];

// 统计数字：自动算，不撒谎
const reviewCount = reviews.length;


// 来源标签的显示文案
const sourceLabels = {
  'manufacturer': 'Manufacturer specs',
  'independent-testing': 'Independent testing',
  'buyer-feedback': 'Buyer feedback',
};

---
<Base
  title="DealWillow — Appliance Reviews with Nothing Invented"
  description="Research-based reviews of phones, TVs, washers, cameras and smart home gear. Manufacturer specs, named lab testing, and verified buyer feedback — clearly labeled, never invented."
>
  <main>
  <!-- ===== 口号区：深蓝大横幅 ===== -->
  <section class="hero">
    <div class="wrap hero-in single">
      <div class="hero-left">
        <p class="hero-stat">{reviewCount} in-depth review{reviewCount === 1 ? '' : 's'}</p>
        <h1>Appliance reviews with <span class="hl">nothing invented</span></h1>
        <p class="sub">We summarize manufacturer specs, named lab tests, and verified buyer feedback for phones, TVs, washers, cameras, and smart home gear — and we label where every claim comes from.</p>
        <div class="search-box">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input id="search" type="search" placeholder="Search reviews — try “TV”, “camera”, “washer”…" autocomplete="off" />
        </div>

        <!-- 板块导航：两个大按钮（当前板块实底高亮） -->
        <div class="section-nav">
          <a class="section-btn active" href="/">Reviews</a>
          <a class="section-btn" href="/amazon/">Amazon</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 信任背书区：诚信原则三承诺 ===== -->
  <section class="trust">
    <div class="wrap trust-grid">
      <div class="trust-item">
        <span class="trust-icon">✓</span>
        <div>
          <p class="trust-t">Research, not theater</p>
          <p class="trust-d">We don't pretend to lab-test anything. When there's real testing, we name who did it.</p>
        </div>
      </div>
      <div class="trust-item">
        <span class="trust-icon">✓</span>
        <div>
          <p class="trust-t">Sources, clearly labeled</p>
          <p class="trust-d">Manufacturer claims, independent lab results, and buyer feedback are marked as what they are.</p>
        </div>
      </div>
      <div class="trust-item">
        <span class="trust-icon">✓</span>
        <div>
          <p class="trust-t">No invented numbers</p>
          <p class="trust-d">Prices are dated, ratings are sourced. Anything we can't verify gets a note — not a guess.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 主体双列：左内容流 + 右侧栏 ===== -->
  <div class="wrap home-cols">
    <div class="home-main">
      <!-- 区块一：测评文章 -->
      <section class="section" id="section-reviews">
        <div class="section-head">
          <h2>📋 Product reviews</h2>
          <span class="section-note">Research summaries — every claim labeled by source</span>
        </div>
        <div class="review-list">
          {reviews.map((r) => (
            <a class="review-card" data-review-card data-category={r.category} data-search={`${r.title} ${r.summary}`.toLowerCase()} href={`/review/${r.id}/`}>
              <div class="review-card-head">
                <span class="review-cat">{(categories.find((c) => c.slug === r.category) || {}).label || r.category}</span>
                <span class="review-updated">Updated {r.updated}</span>
              </div>
              <h3 class="review-title">{r.title}</h3>
              <p class="review-summary">{r.summary}</p>
              <div class="review-sources">
                {r.sources.map((s) => <span class="source-tag">{sourceLabels[s] || s}</span>)}
              </div>
            </a>
          ))}
        </div>
      </section>


      <!-- 搜索/过滤无结果时的提示 -->
      <p class="empty" id="empty" hidden>No matches — try another word or category.</p>
    </div>

  </div>
  </main>
</Base>

<script>
  // ===== 搜索 + 分类过滤（文章卡和商品卡统一过滤）=====
  const input = document.getElementById('search');
  const emptyEl = document.getElementById('empty');

  function applyFilter() {
    const q = input.value.trim().toLowerCase();
    let visible = 0;
    document.querySelectorAll('[data-review-card]').forEach((card) => {
      const hay = card.dataset.search || '';
      const show = !q || hay.includes(q);
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    // 某个区块如果全空了，把区块标题也藏起来
    document.querySelectorAll('.section').forEach((sec) => {
      const cards = sec.querySelectorAll('[data-review-card]');
      const anyVisible = [...cards].some((c) => c.style.display !== 'none');
      sec.hidden = !anyVisible;
    });

    emptyEl.hidden = visible > 0;
  }

  input?.addEventListener('input', applyFilter);
</script>

<style>
  /* ===== 口号区：深蓝大横幅 ===== */
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #0d2f6e 0%, #1e66f5 100%);
    padding: 56px 0 64px;
    border-radius: 0 0 26px 26px;
    box-shadow: 0 12px 40px rgba(13, 47, 110, 0.25);
  }
  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .hero::before {
    width: 420px; height: 420px;
    background: rgba(255, 255, 255, 0.06);
    top: -180px; right: -120px;
  }
  .hero::after {
    width: 280px; height: 280px;
    background: rgba(255, 255, 255, 0.05);
    bottom: -120px; left: -90px;
  }
  .hero-in {
    position: relative; z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 44px;
    align-items: center;
  }
  .hero-in.single { grid-template-columns: 1fr; max-width: 720px; }
  .hero-left { text-align: left; }

  .hero-stat {
    margin: 0 0 10px;
    display: inline-block;
    font-size: 12.5px; font-weight: 700;
    color: #fde047;
    background: rgba(253, 224, 71, 0.14);
    border: 1px solid rgba(253, 224, 71, 0.4);
    padding: 4px 12px; border-radius: 999px;
    letter-spacing: 0.02em;
  }
  .hero h1 {
    margin: 0 0 14px;
    font-size: 34px;
    font-weight: 800;
    letter-spacing: -0.6px;
    line-height: 1.18;
    color: #fff;
  }
  .hl {
    background: linear-gradient(180deg, transparent 60%, #fde047 60%);
    padding: 0 3px;
  }
  .sub { margin: 0 0 24px; color: rgba(255, 255, 255, 0.85); font-size: 16px; max-width: 560px; line-height: 1.6; }

  /* ===== 搜索框 ===== */
  .search-box {
    display: flex; align-items: center; gap: 10px;
    max-width: 480px;
    background: #fff;
    border-radius: 999px;
    padding: 13px 20px;
    box-shadow: 0 10px 30px rgba(4, 20, 54, 0.35);
    color: var(--muted);
    transition: box-shadow 0.15s ease;
  }
  .search-box:focus-within { box-shadow: 0 0 0 4px rgba(253, 224, 71, 0.55), 0 10px 30px rgba(4, 20, 54, 0.35); }
  .search-box input {
    border: none; outline: none; flex: 1;
    font-size: 15px; font-family: inherit; color: var(--ink);
    background: transparent;
  }
  .search-box input::placeholder { color: #9ca3af; }

  /* ===== 板块导航：两个大按钮 ===== */
  .section-nav { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 24px; }
  .section-btn {
    display: inline-block;
    border: 2px solid rgba(255, 255, 255, 0.55);
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border-radius: 999px;
    padding: 13px 42px;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: 0.01em;
    text-decoration: none;
    backdrop-filter: blur(4px);
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .section-btn:hover { background: rgba(255, 255, 255, 0.22); transform: translateY(-1px); }
  .section-btn.active {
    background: #fff;
    border-color: #fff;
    color: #1e66f5;
    box-shadow: 0 8px 22px rgba(4, 20, 54, 0.35);
  }

  /* ===== 信任背书区 ===== */
  .trust { padding: 26px 0 6px; }
  .trust-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .trust-item {
    display: flex; gap: 12px; align-items: flex-start;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px 16px;
  }
  .trust-icon {
    width: 22px; height: 22px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: #dcfce7; color: #15803d;
    border-radius: 50%;
    font-size: 13px; font-weight: 800;
    margin-top: 1px;
  }
  .trust-t { margin: 0; font-size: 14px; font-weight: 700; }
  .trust-d { margin: 2px 0 0; font-size: 12.5px; color: var(--muted); line-height: 1.45; }

  /* ===== 主体双列 ===== */
  .home-cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    align-items: start;
    padding-top: 30px;
  }
  .side { position: sticky; top: 84px; }
  .side-box {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 18px;
    margin-bottom: 18px;
  }
  .side-title { margin: 0 0 12px; font-size: 15px; font-weight: 800; letter-spacing: -0.2px; }

  /* 侧栏文章入口 */
  .side-review { display: flex; flex-direction: column; gap: 3px; text-decoration: none; padding: 9px 4px; }
  .side-review + .side-review { border-top: 1px solid var(--border); }
  .side-review-title { font-size: 13.5px; font-weight: 700; color: var(--ink); line-height: 1.35; }
  .side-review:hover .side-review-title { color: var(--blue); }
  .side-review-meta { font-size: 12px; color: var(--muted); }

  /* 排行榜 */
  .rank { margin: 0; padding: 0; list-style: none; }
  .rank li + li { border-top: 1px solid var(--border); }
  .rank-item {
    display: grid;
    grid-template-columns: 22px 1fr;
    grid-template-rows: auto auto;
    gap: 1px 8px;
    padding: 10px 4px;
    text-decoration: none;
  }
  .rank-num {
    grid-row: 1 / 3;
    width: 22px; height: 22px;
    display: flex; align-items: center; justify-content: center;
    background: var(--yellow-bg); color: var(--yellow-ink);
    border-radius: 6px;
    font-size: 12px; font-weight: 800;
  }
  .rank-name {
    font-size: 13px; font-weight: 700; color: var(--ink); line-height: 1.3;
    display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
  }
  .rank-meta { font-size: 12px; color: var(--muted); }

  /* ===== 测评文章卡 ===== */
  .review-list { display: flex; flex-direction: column; gap: 14px; }
  .review-card {
    display: block;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px 22px;
    text-decoration: none;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .review-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.12);
    border-color: var(--blue);
  }
  .review-card-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 10px; }
  .review-cat {
    font-size: 11.5px; font-weight: 800;
    color: #1e66f5; background: #e0ecff;
    padding: 3px 10px; border-radius: 999px;
    letter-spacing: 0.02em;
  }
  .review-updated { font-size: 12px; color: var(--muted); }
  .review-title { margin: 0 0 8px; font-size: 20px; font-weight: 800; letter-spacing: -0.3px; line-height: 1.25; color: var(--ink); }
  .review-summary { margin: 0 0 14px; font-size: 14.5px; color: #4b5563; line-height: 1.6; }
  .review-sources { display: flex; flex-wrap: wrap; gap: 7px; }
  .source-tag {
    font-size: 11.5px; font-weight: 700;
    color: #374151; background: #f3f4f6;
    border: 1px solid var(--border);
    padding: 3px 9px; border-radius: 6px;
  }

  /* ===== 区块 ===== */
  .section { margin-top: 30px; }
  .section:first-child { margin-top: 0; }
  .section-head { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
  .section-head h2 { margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -0.3px; }
  .section-note { font-size: 13px; color: var(--muted); }

  /* ===== 商品卡网格 ===== */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 18px;
  }

  .empty { text-align: center; color: var(--muted); padding: 48px 0; font-size: 15px; }

  /* ===== 响应式 ===== */
  @media (max-width: 1020px) {
    .home-cols { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .hero { padding: 36px 0 44px; border-radius: 0 0 18px 18px; }
    .hero h1 { font-size: 27px; }
    .sub { font-size: 14.5px; max-width: 320px; }
    .search-box { max-width: 100%; }
    .trust-grid { grid-template-columns: 1fr; }
    .grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .section { margin-top: 26px; }
  }
</style>
